# Supabase (required on Vercel)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard password
ADMIN_PASSWORD=ayelet2026
ADMIN_SESSION_SECRET=

# Public site URL (Open Graph + WhatsApp links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Green API (WhatsApp reminders)
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# Optional host override (default https://api.greenapi.com)
# GREEN_API_URL=https://api.greenapi.com

# WhatsApp number(s) notified when a guest confirms / updates RSVP.
# Multiple organizers: comma-separated.
# Example: ORGANIZER_NOTIFY_PHONE=+972544854584,+9725XXXXXXXX
ORGANIZER_NOTIFY_PHONE=+972544854584
# Optional alias for the same list:
# ORGANIZER_NOTIFY_PHONES=+972544854584,+9725XXXXXXXX

# Incoming WhatsApp webhook (Green API → this app) for adding guests by template.
# Set webhook URL in Green API console to:
#   https://YOUR_DOMAIN/api/whatsapp/webhook?token=YOUR_SECRET
# GREEN_API_WEBHOOK_TOKEN=YOUR_SECRET

# Optional: absolute path override for Excel import
# IMPORT_XLSX_PATH=
