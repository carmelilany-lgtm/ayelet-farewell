# Supabase (required on Vercel)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard password
ADMIN_PASSWORD=ayelet2026
ADMIN_SESSION_SECRET=

# Public site URL (Open Graph + WhatsApp links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Green API (WhatsApp reminders)
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# Optional host override. If unset, derived from instance id prefix
# (e.g. 7107227… → https://7107.api.greenapi.com). Copy exact apiUrl from Green API console if sends fail.
# GREEN_API_URL=https://7107.api.greenapi.com

# WhatsApp number(s) notified when a guest confirms / updates RSVP.
# Multiple organizers: comma-separated.
# Example: ORGANIZER_NOTIFY_PHONE=+972544854584,+972524059013
ORGANIZER_NOTIFY_PHONE=+972544854584,+972524059013
# Optional alias for the same list:
# ORGANIZER_NOTIFY_PHONES=+972544854584,+972524059013

# Incoming WhatsApp webhook (Green API → this app) for adding guests by template.
# Set webhook URL in Green API console to:
#   https://YOUR_DOMAIN/api/whatsapp/webhook?token=YOUR_SECRET
# GREEN_API_WEBHOOK_TOKEN=YOUR_SECRET

# Joke-only WhatsApp numbers (not organizers). Send "בדיחה" → short joke from the web.
# No guest add / menu access. Organizers can also send "בדיחה".
# Example: JOKE_AUTHORIZED_PHONES=+972501234567
# JOKE_AUTHORIZED_PHONES=

# Personal Carmel-style auto-reply (OpenAI). Isolated from RSVP / organizer flows.
# Only these phones get chat replies that mimic Carmel's WhatsApp voice.
# Example: PERSONAL_AUTO_REPLY_PHONES=0547174429
# PERSONAL_AUTO_REPLY_PHONES=
# OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini):
# OPENAI_MODEL=gpt-4o-mini

# Optional: absolute path override for Excel import
# IMPORT_XLSX_PATH=
